# ── 部署配置模板（复制为 .env 后按需修改）────────────────────────────────────
#
#   cp .env.example .env
#
# 说明：
# - 这份文件同时是 compose 的「插值源」（${VAR} 替换）与容器的 env_file
#   （应用侧 OPENAI_* 等变量）。environment 段里已写死的键（DATA_DIR 等）
#   以 compose 文件为准，不在此重复。
# - .env 不进版本控制（见 .gitignore）；本模板会提交。

# ── 镜像来源 ────────────────────────────────────────────────────────────────
#
# 默认用 GHCR 上已发布的公开镜像（匿名可拉），`docker compose pull` 即可。
# 想钉住别的版本就改这里，例如 .../auto-register:0.1 或 :latest。
# 想自己从源码构建：`docker compose up -d --build`（build 段会盖过 image）。
# APP_IMAGE=ghcr.io/ifuzyi/auto-register:0.1.0

# ── 端口与数据 ──────────────────────────────────────────────────────────────

# 面板端口。默认 8000 对外；要改绑定地址写成 IP:PORT，例 127.0.0.1:8000 只绑本机
# APP_PORT_BIND=8000

# 运行时数据目录（SQLite 库 + 凭据密钥 + 日志）。**部署前就要定好** ——
# 换路径 = 换一个空库，已保存的密码与配置都会看不见。
# APP_RUNTIME_BIND=./data

# Solver 端口绑定。默认只绑本机，容器内部访问不受影响。
# SOLVER_PORT_BIND=127.0.0.1:8889

# 容器内存上限。浏览器（Camoufox + Chromium）是内存大户，泄漏或僵尸进程
# 会一路吃满宿主机；设上限让内核 OOM killer 只杀这个容器，而不是拖垮整台机。
# 按并发调：每个浏览器上下文约 300–500MB。宿主机内存小时可下调（如 2g）。
# APP_MEMORY_LIMIT=4g

# ── 基础镜像（受限网络）─────────────────────────────────────────────────────
#
# Docker Hub 不可达时（registry-1.docker.io TLS 失败 / 连接被重置），
# 换成可达的镜像源再构建。示例（daocloud 镜像）：
# NODE_IMAGE=docker.m.daocloud.io/library/node:20-bookworm-slim
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
#
# NODE_IMAGE=node:20-bookworm-slim
# PYTHON_IMAGE=python:3.12-slim

# ── 浏览器栈 ────────────────────────────────────────────────────────────────

# Camoufox 版本兜底值：构建脚本**优先读 camoufox 包自带的 browser-pin.json**
# （pip 升级包后浏览器自动跟着升，不会错配）；这两个变量仅在包不带 pin
# （开发版）时生效。一般不需要设置。
# CAMOUFOX_VERSION=135.0.1
# CAMOUFOX_RELEASE=beta.24

# Solver 浏览器类型：camoufox（默认，唯一能过 x.ai CF 的）或 chromium
# SOLVER_BROWSER_TYPE=camoufox

# 浏览器无头模式（留空 = 按各平台默认；容器内建议保持默认 headless）
# PLAYWRIGHT_HEADLESS=

# ── 存储后端 ────────────────────────────────────────────────────────────────
#
# sqlite（默认）或 json。**全新部署**不填时用 json；已有 SQLite 库时不填则
# 继续用 sqlite —— 静默换库会让已有账号/配置「看起来消失」（实际是读不到）。
#
# 覆盖范围（截至 2026-10-27）：**全部数据都在 JSON 里**
#   config.json / accounts.json / proxies.json / task_runs.json /
#   task_logs.json / icloud_accounts.json / icloud_aliases.json /
#   outlook_accounts.json
#
# **不会创建任何 `.db` 文件** —— 全部表接线后 `init_db` 跳过建库与迁移。
# `tests/test_json_deployment_end_to_end.py` 断言了这一点。
#
# 「只有读写都接线才切」是硬要求：只接写会得到「写 JSON、读 SQLite →
# 看不到刚写的行」。接线步骤见 `core/storage/json_table.py` 的注释。
#
# 切换前请先导出备份（「全局配置 → 数据迁移」），备份含两种后端的文件。
#
# STORAGE_BACKEND=json

# 账号是否也走 JSON。默认跟随总开关；
# 设 `sqlite` 可让「配置走 JSON、账号留 SQLite」——
# 从 SQLite 迁到 JSON 时，可以先把配置切过去观察，账号晚一步。
#
# STORAGE_BACKEND_ACCOUNTS=sqlite

# ── 应用级变量（直接注入容器环境）───────────────────────────────────────────
#
# 这些是应用运行时读取的变量（os.getenv），写在这里会进容器环境：
#
# Node 不在 PATH 时指定绝对路径（ChatGPT Sentinel PoW 求解器需要）。
# 本项目镜像里 node 位于 /usr/bin/node（apt 安装）；用 `command -v node` 确认。
# OPENAI_SENTINEL_NODE_PATH=/usr/bin/node
#
# Solver 代理支持开关（默认 1=启用，设 0 关闭）
# SOLVER_PROXY_ENABLED=1
#
# Solver 浏览器池的空闲回收。池按 --thread（默认 4）预热后每个浏览器约 250 MiB，
# 常驻不动实测占 1.0 GiB（RSS+Swap）—— 在 2 GiB 的机器上会把 swap 吃满。
# 空闲超过 TTL（秒，默认 300）后整池关掉，下一个解题请求按需重建（约 30s 预热）。
# 设 0 = 关掉回收（池常驻，只在内存充裕时用）。
# SOLVER_IDLE_TTL=300
#
# 回收检查间隔（秒，默认 30）。TTL 是回收滞后上界，间隔决定检查粒度。
# SOLVER_IDLE_INTERVAL=30
#
# 面板登录 JWT 密钥（不设则自动生成并存库）
# APP_JWT_SECRET=

# 凭据加密密钥本体（base64/hex 32 字节）。不设时用挂载卷里的密钥文件
# （默认 /runtime/secrets/credential_key，由容器首次启动自动生成）。
# ⚠️ 换掉它会让库里已加密的凭据全部解不开。
# CREDENTIAL_ENCRYPTION_KEY=
